{
  "name": "EdgeClose enterprise settings",
  "description": "Administrator-managed EdgeClose website rules.",
  "type": "object",
  "properties": {
    "sites": {
      "type": "array",
      "description": "Website rules controlled by the administrator.",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Website domain, IP address, or URL pattern."
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 86400
          },
          "warningSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86399
          },
          "fromTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "toTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "soundEnabled": {
            "type": "boolean"
          }
        },
        "required": ["pattern", "timeoutSeconds", "warningSeconds"],
        "additionalProperties": false
      }
    }
  }
}
